# Copy to .env.local for development. Never commit real values.
# Only variables prefixed NEXT_PUBLIC_ are exposed to the browser. Everything else is server-only.

# ── Public (safe for the browser) ─────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://syncflow.agency
# Lemon Squeezy overlay checkout URL (public by nature). Defaults to the production link in lib/site.ts.
# NEXT_PUBLIC_CHECKOUT_URL=https://syncflow.lemonsqueezy.com/checkout/buy/<uuid>?embed=1&dark=1

# ── Server-only secrets ───────────────────────────────────────────────────────
# Where validated contact-form submissions are delivered (n8n, Make, Zapier, Slack workflow, your CRM).
# Must be https:// (http:// is accepted only for localhost testing). If unset, the form answers 503 in production.
CONTACT_WEBHOOK_URL=
# Optional: HMAC-SHA256 signing secret. The body signature is sent in the "x-syncflow-signature" header.
CONTACT_WEBHOOK_SECRET=

# Optional shared rate-limit store (Upstash Redis REST). Without it the limiter is per-instance memory only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
