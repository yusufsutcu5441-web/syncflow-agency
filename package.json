{
  "name": "syncflow-agency",
  "version": "2.0.0",
  "private": true,
  "description": "SyncFlow Agency: high-ticket B2B website. Next.js App Router, next-intl (en, tr), pre-rendered Remotion film (no player in the browser), nonce-based CSP in report-only mode.",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:messages": "node scripts/check-messages.mjs",
    "check:fonts": "python scripts/check-fonts.py",
    "check:csp-hash": "node scripts/lemon-style-hash.mjs",
    "check": "npm run check:messages && npm run typecheck && npm run lint",
    "smoke": "node scripts/smoke.mjs",
    "perf": "node scripts/lighthouse.mjs",
    "audit:secrets": "node scripts/audit-secrets.mjs",
    "film:render": "node scripts/render-film.mjs",
    "remotion:studio": "node scripts/render-film.mjs --studio",
    "dev:inbox": "node scripts/dev-inbox.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "dompurify": "^3.4.16",
    "jsdom": "^29.1.1",
    "lenis": "^1.3.26",
    "lucide-react": "^1.52.0",
    "motion": "^14.0.0",
    "next": "16.3.8",
    "next-intl": "^4.14.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "remotion": "4.0.533",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3"
  }
}
