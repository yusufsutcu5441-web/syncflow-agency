# Cloudflare Pages başlıkları. Vercel için aynı kurallar vercel.json içinde.
# Webhook (data-endpoint) kullanırsan Content-Security-Policy içindeki connect-src'ye adresini ekle.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self'; base-uri 'none'; frame-ancestors 'none'; object-src 'none'

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/img/*
  Cache-Control: public, max-age=2592000

/assets/css/*
  Cache-Control: public, max-age=3600, must-revalidate

/assets/js/*
  Cache-Control: public, max-age=3600, must-revalidate

# Geliştirme dosyaları yayınlansa bile indekslenmesin
/package.json
  X-Robots-Tag: noindex
/README.md
  X-Robots-Tag: noindex
/src/*
  X-Robots-Tag: noindex
/scripts/*
  X-Robots-Tag: noindex
/remotion/*
  X-Robots-Tag: noindex
/THIRD-PARTY-NOTICES.txt
  X-Robots-Tag: noindex
