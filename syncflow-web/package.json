{
  "name": "syncflow-agency",
  "version": "2.0.0",
  "private": true,
  "description": "SyncFlow Agency: high-ticket B2B website. Next.js App Router, next-intl (en, tr), pre-rendered Remotion film (no player in the browser), nonce-based enforced CSP.",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:eager": "node scripts/build-eager.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:messages": "node scripts/check-messages.mjs",
    "check:fonts": "python scripts/check-fonts.py",
    "brand:build": "node scripts/build-brand.mjs",
    "brand:check": "node scripts/build-brand.mjs --check",
    "flags:build": "node scripts/build-flags.mjs",
    "flags:check": "node scripts/build-flags.mjs --check",
    "arch:verify": "node scripts/arch-verify.mjs",
    "delivery:verify": "node --test tests/delivery/smtp.test.mjs",
    "release:verify": "node scripts/release-verify.mjs",
    "arch:examples": "node scripts/arch-verify.mjs --write-examples",
    "qa:browser": "node scripts/browser-flow.mjs",
    "qa:browser:quick": "node scripts/browser-flow.mjs --quick",
    "qa:csp": "node scripts/qa-csp.mjs",
    "perf:gate": "node scripts/perf-gate.mjs",
    "check": "npm run check:messages && npm run typecheck && npm run lint",
    "smoke": "node scripts/smoke.mjs",
    "live": "node scripts/live-check.mjs",
    "perf": "node scripts/lighthouse.mjs",
    "audit:secrets": "node scripts/audit-secrets.mjs",
    "film:render": "node scripts/render-film.mjs",
    "remotion:studio": "node scripts/render-film.mjs --studio",
    "dev:inbox": "node scripts/dev-inbox.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "dompurify": "^3.4.16",
    "jsdom": "^26.1.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.52.0",
    "motion": "^14.0.0",
    "next": "16.3.8",
    "next-intl": "^4.14.9",
    "nodemailer": "^10.1.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.19.1",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "puppeteer-core": "^25.14.0",
    "remotion": "4.0.533",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3"
  }
}
