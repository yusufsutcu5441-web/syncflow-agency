# Copy to .env.local for development. Never commit real values.
# Only variables prefixed NEXT_PUBLIC_ are exposed to the browser. Everything else is server-only.

# ── Public (safe for the browser) ─────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://syncflow.agency

# The public contact mailbox: every mail link on the site, the direct-contact line, the legal notice and the structured data. Written nowhere
# in the code. Unset, the build has NO mail link and NO contact address on the page (the build prints a warning).
NEXT_PUBLIC_CONTACT_EMAIL=

# Release switches (docs/adr/0035-sales-ready-release.md). Both are OFF unless set to "true" (or "1"); NEXT_PUBLIC_ values are inlined at build time.
#  SHOW_PRICING      the investment bands (lib/pricing.ts) and the currency tags of the entry gate. Off: no amount and no currency on the site.
#  BRIEFING_ENABLED  the Strategic Briefing form, its links and POST /api/briefing. Off: no section, no links, and the API answers 404. The form's first
#                    step is the price question, so it needs SHOW_PRICING too: with only this one on, the form stays off and the build warns.
#                    Turning it on brings back the long privacy notice, which still has [BRACKETED] fields (docs/legal-facts-intake.md): fill them first.
NEXT_PUBLIC_SHOW_PRICING=
NEXT_PUBLIC_BRIEFING_ENABLED=

# Which languages are PUBLIC in EVERY environment, development included (hreflang, sitemap, language switcher, entry gate cards;
# anything else answers 404). English and Turkish are public by default (docs/adr/0035); Arabic, German, French, Spanish and Chinese
# (docs/adr/0018) and Japanese are dormant DRAFTS, their message files untouched. Their translations have had no native-speaker or legal
# review. To open the seven capital-centre languages again set "en,tr,ar,de,fr,es,zh" and rebuild.
NEXT_PUBLIC_LAUNCHED_LOCALES=en,tr
# NEXT_PUBLIC_PREVIEW_LOCALES=1   # opens every routed language (the dormant Japanese draft too; dev and production builds alike); nothing links to it

# Cloudflare Turnstile (bot check of the briefing). Create a widget in the Cloudflare dashboard.
# For local development without keys the check is skipped; in production the form refuses to send without the secret.
# Cloudflare's always-pass test keys: site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional footer links. Nothing is invented: a link appears only when its address is set.
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_WHATSAPP_URL=

# ── Server-only secrets ───────────────────────────────────────────────────────
# Where every briefing is delivered: the n8n webhook that sends the mail to contact@syncflow.agency through Gmail
# (docs/n8n-briefing.md). Must be https:// (http:// is accepted only for localhost testing). If unset, the form answers 503
# in production and offers a prepared e-mail instead.
CONTACT_WEBHOOK_URL=
# HMAC-SHA256 signing secret shared with n8n. The body signature is sent in the "x-syncflow-signature" header.
CONTACT_WEBHOOK_SECRET=

# Turnstile secret key (server-side verification of the token).
TURNSTILE_SECRET_KEY=

# OPTIONAL, instead of the webhook above: send the briefing as a plain-text e-mail by SMTP (docs/adr/0027-optional-smtp-delivery.md). Used only
# when CONTACT_WEBHOOK_URL is NOT set. Trade-off: a mail credential then lives in this deployment's environment. Use a DEDICATED sender account
# (a Gmail app password also opens that account's whole mailbox), and route the briefing to the real inbox with BRIEFING_INBOX.
# Gmail / Google Workspace: SMTP_USER=site@syncflow.agency, SMTP_PASSWORD = a 16-letter app password (2-Step Verification must be on).
# Another SMTP provider: set SMTP_HOST (and SMTP_PORT, SMTP_FROM when the login is not an address).
SMTP_USER=
SMTP_PASSWORD=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_FROM=
# BRIEFING_INBOX=contact@syncflow.agency

# OPTIONAL, free, no n8n and no mail account: an instant message to your phone and computer through Telegram (docs/adr/0034-telegram-lead-alert.md,
# docs/go-live-checklist.md path C). Create a bot with @BotFather, press Start on it, then find your chat id with `npm run telegram:check -- --find-chat`
# (it reads TELEGRAM_BOT_TOKEN from your shell; the token is never printed). With a webhook or SMTP set, Telegram only ALERTS (company, priority, answers;
# no name, e-mail address or message text) and takes over the whole briefing if that delivery fails. With neither set, Telegram carries the whole briefing and is
# the only way out. Use a PRIVATE chat: the id must be a number (a @channel name is refused, a group id shows every briefing to every member).
# The token can send messages as the bot and read what is sent to it; it opens no mailbox and none of your other chats. Revoke it in @BotFather (/revoke).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# TELEGRAM_API_BASE=http://127.0.0.1:8081   # tests only (a fake on loopback) or a self-hosted Bot API server; https or loopback http, nothing else is accepted

# Optional shared rate-limit store (Upstash Redis REST). Without it the limiter is per-instance memory only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# How the Content-Security-Policy is delivered. Unset (or anything but "report-only") = enforced since 17.10.2026
# (docs/adr/0024-csp-enforced.md): the browser blocks what the policy does not allow, and violations are reported to
# /api/csp-report. "report-only" is the instant revert: violations are still reported and logged, nothing is blocked.
# CSP_MODE=report-only
