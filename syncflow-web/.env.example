# Copy to .env.local for development. Never commit real values.
# Only variables prefixed NEXT_PUBLIC_ are exposed to the browser. Everything else is server-only.

# ── Public (safe for the browser) ─────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://syncflow.agency

# Which languages are PUBLIC in EVERY environment, development included (hreflang, sitemap, language switcher, entry gate cards;
# anything else answers 404). The seven capital-centre languages (en tr ar de fr es zh) are public by default (docs/adr/0018);
# Japanese is a dormant DRAFT. Leave this unset on the host, or set "en,tr" and rebuild to close the five newer languages again.
# Their translations have had no native-speaker or legal review (the owner launched them knowingly, 14.10.2026).
# NEXT_PUBLIC_ values are inlined at build time.
NEXT_PUBLIC_LAUNCHED_LOCALES=en,tr,ar,de,fr,es,zh
# NEXT_PUBLIC_PREVIEW_LOCALES=1   # opens every routed language (the dormant Japanese draft too; dev and production builds alike); nothing links to it

# Cloudflare Turnstile (bot check of the briefing). Create a widget in the Cloudflare dashboard.
# For local development without keys the check is skipped; in production the form refuses to send without the secret.
# Cloudflare's always-pass test keys: site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional footer links. Nothing is invented: a link appears only when its address is set.
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_WHATSAPP_URL=

# ── Server-only secrets ───────────────────────────────────────────────────────
# Where every briefing is delivered: the n8n webhook that sends the mail to contact@syncflow.agency through Gmail
# (docs/n8n-briefing.md). Must be https:// (http:// is accepted only for localhost testing). If unset, the form answers 503
# in production and offers a prepared e-mail instead.
CONTACT_WEBHOOK_URL=
# HMAC-SHA256 signing secret shared with n8n. The body signature is sent in the "x-syncflow-signature" header.
CONTACT_WEBHOOK_SECRET=

# Turnstile secret key (server-side verification of the token).
TURNSTILE_SECRET_KEY=

# OPTIONAL, instead of the webhook above: send the briefing as a plain-text e-mail by SMTP (docs/adr/0027-optional-smtp-delivery.md). Used only
# when CONTACT_WEBHOOK_URL is NOT set. Trade-off: a mail credential then lives in this deployment's environment. Use a DEDICATED sender account
# (a Gmail app password also opens that account's whole mailbox), and route the briefing to the real inbox with BRIEFING_INBOX.
# Gmail / Google Workspace: SMTP_USER=site@syncflow.agency, SMTP_PASSWORD = a 16-letter app password (2-Step Verification must be on).
# Another SMTP provider: set SMTP_HOST (and SMTP_PORT, SMTP_FROM when the login is not an address).
SMTP_USER=
SMTP_PASSWORD=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_FROM=
# BRIEFING_INBOX=contact@syncflow.agency

# Optional shared rate-limit store (Upstash Redis REST). Without it the limiter is per-instance memory only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# How the Content-Security-Policy is delivered. Unset (or anything but "report-only") = enforced since 17.10.2026
# (docs/adr/0024-csp-enforced.md): the browser blocks what the policy does not allow, and violations are reported to
# /api/csp-report. "report-only" is the instant revert: violations are still reported and logged, nothing is blocked.
# CSP_MODE=report-only
